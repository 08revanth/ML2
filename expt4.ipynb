

import pandas as pd

url = "https://archive.ics.uci.edu/ml/machine-learning-databases/mushroom/agaricus-lepiota.data"
print("Downloading Mushroom dataset...")
data = pd.read_csv(url, header=None)
print("\nDataset loaded successfully!")
print("Shape:", data.shape)

columns = [
    "class", "cap_shape", "cap_surface", "cap_color", "bruises", "odor",
    "gill_attachment", "gill_spacing", "gill_size", "gill_color", "stalk_shape",
    "stalk_root", "stalk_surface_above_ring", "stalk_surface_below_ring",
    "stalk_color_above_ring", "stalk_color_below_ring", "veil_type",
    "veil_color", "ring_number", "ring_type", "spore_print_color",
    "population", "habitat"
]

data.columns = columns
print("\nFirst 5 rows:")
print(data.head())

data = data.replace("?", pd.NA)
data = data.dropna()
print("\nDataset after removing missing values:")
print(data.shape)

target = "class"
attributes = list(data.columns)
attributes.remove(target)
num_attributes = len(attributes)

S = ["∅"] * num_attributes
G = [["?"] * num_attributes]

print("\n============================================")
print("CANDIDATE-ELIMINATION ALGORITHM")
print("============================================")
print("\nNumber of attributes:", num_attributes)
print("Initial Specific Boundary (S_0):", S)
print("Initial General Boundary (G_0):", G)


def satisfies(instance, hypothesis, attributes):
    """Check if an instance satisfies a given hypothesis."""
    for i in range(len(attributes)):
        if hypothesis[i] != "?" and hypothesis[i] != instance[attributes[i]]:
            return False
    return True


def is_more_general(h1, h2):
    """Check if hypothesis h1 is strictly more general than h2."""
    for i in range(len(h1)):
        if h1[i] != "?" and h1[i] != h2[i]:
            return False
    return True


positive_count = 0
negative_count = 0

for index, row in data.iterrows():
    label = str(row[target]).strip().lower()


    if label == "e":
        positive_count += 1


        G = [g for g in G if satisfies(row, g, attributes)]


        for i in range(num_attributes):
            if S[i] == "∅":
                S[i] = row[attributes[i]]
            elif S[i] != row[attributes[i]]:
                S[i] = "?"


    elif label == "p":
        negative_count += 1

        new_G = []
        for g in G:
            if satisfies(row, g, attributes):

                for i in range(num_attributes):
                    if g[i] == "?":
                        if S[i] != "?" and S[i] != row[attributes[i]]:
                            new_g = g.copy()
                            new_g[i] = S[i]
                            new_G.append(new_g)
            else:
                new_G.append(g)


        filtered_G = []
        for g1 in new_G:
            is_redundant = False
            for g2 in new_G:
                if g1 != g2 and is_more_general(g1, g2):
                    is_redundant = True
                    break
            if not is_redundant:
                filtered_G.append(g1)

        G = filtered_G


print("\n============================================")
print("FINAL RESULT")
print("============================================")
print("Total Positive Examples Processed:", positive_count)
print("Total Negative Examples Processed:", negative_count)

print("\nMost Specific Boundary (S_final):")
for attribute, value in zip(attributes, S):
    print(f"{attribute} = {value}")

print("\nMost General Boundary (G_final):")
print(G)
     
